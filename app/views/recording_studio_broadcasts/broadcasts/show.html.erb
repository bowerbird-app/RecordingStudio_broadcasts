<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% if (returned = broadcast_publishable_return_notice(@recording)) %>
    <%= render FlatPack::Alert::Component.new(description: returned, style: :warning) %>
  <% end %>
  <%= render "header",
        title: @broadcast.title,
        subtitle: @broadcast.subject,
        badge: broadcast_status_badge(@broadcast) %>
  <% schedule = broadcast_schedule_state(@recording, @broadcast) %>

  <% details = [
       { label: "Subject", value: @broadcast.subject },
       { label: "Message", value: @broadcast.body.presence || "No message yet." },
       { label: "Who gets it", value: broadcast_filter_summary(@broadcast) }
     ] %>
  <% if schedule %>
    <% details << { label: schedule_label(@broadcast),
                    value: l(schedule[:time].in_time_zone, format: :long) } %>
  <% end %>
  <%= render "key_values", rows: details %>

  <%= render FlatPack::PageTitle::Component.new(title: "Who gets it", variant: :h2) %>
  <%= render "key_values", rows: [
        { label: "Matching", value: @preview[:matching].to_s },
        { label: "Ready", value: @preview[:eligible].to_s },
        { label: "Left out", value: @preview[:excluded].to_s }
      ] %>

  <% if @delivery.any? %>
    <%= render FlatPack::PageTitle::Component.new(title: "Delivery", variant: :h2) %>
    <% delivery = RecordingStudioBroadcasts::Recipient::STATUS_LABELS.filter_map do |status, label|
         { label: label, value: @delivery[status].to_s } if @delivery.key?(status)
       end %>
    <%= render "key_values", rows: delivery %>
  <% end %>

  <% secondary = %i[test_send update cancel unpublish].select { |action| offered?(action) } %>
  <% if offered?(:send) || secondary.any? || offered?(:delete) %>
    <%= render FlatPack::Collection::Component.new(layout: :wrap, gap: :sm) do |row| %>
      <% if offered?(:send) %>
        <% row.with_item do %>
          <%= render FlatPack::Button::Component.new(
                text: "Send now",
                style: :primary,
                href: send_message_broadcast_path(@recording),
                data: { turbo_method: :post, turbo_confirm: "Send this to #{@preview[:eligible]} people now?" }
              ) %>
        <% end %>
      <% end %>
      <% if offered?(:test_send) %>
        <% row.with_item do %>
          <%= render broadcast_action_button("Send me a test", test_send_broadcast_path(@recording)) %>
        <% end %>
      <% end %>
      <% if offered?(:update) %>
        <% row.with_item do %>
          <%= render FlatPack::Button::Component.new(text: "Edit", href: edit_broadcast_path(@recording)) %>
        <% end %>
      <% end %>
      <% if offered?(:cancel) %>
        <% row.with_item do %>
          <%= render broadcast_action_button(
                "Cancel", cancel_broadcast_path(@recording),
                confirm: "Cancel this broadcast? People not yet emailed will not get it."
              ) %>
        <% end %>
      <% end %>
      <% if offered?(:unpublish) %>
        <% row.with_item do %>
          <%= render broadcast_action_button(
                "Unpublish", unpublish_broadcast_path(@recording),
                confirm: "Unpublish this broadcast? It will not be sent."
              ) %>
        <% end %>
      <% end %>
      <% if offered?(:delete) %>
        <% row.with_item do %>
          <%= render FlatPack::Button::Component.new(
                text: "Delete",
                style: :danger,
                href: broadcast_path(@recording),
                data: { turbo_method: :delete, turbo_confirm: "Delete this draft?" }
              ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if offered?(:schedule) %>
    <%= render FlatPack::PageTitle::Component.new(title: "Schedule", variant: :h2) %>
    <%= form_with url: schedule_broadcast_path(@recording), method: :post do %>
      <%= render FlatPack::Grid::Component.new(cols: 1, gap: :sm) do %>
        <%= render FlatPack::DateTimeInput::Component.new(
          name: "scheduled_at",
          label: "Send at",
          value: @broadcast.scheduled_at&.in_time_zone&.strftime("%Y-%m-%dT%H:%M")
        ) %>
        <%= render FlatPack::Button::Component.new(text: "Schedule", type: "submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

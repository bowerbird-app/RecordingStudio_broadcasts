<% flat_pack_page_nav(
     round: true,
     style: :default,
     anchor_href: page_nav_anchor_url(default: recording_studio_admin_context.admin_screen_path("broadcasts")),
     anchor_tooltip: t("recording_studio.admin.navigation.close", default: "Close"),
     back_tooltip: t("recording_studio.admin.navigation.go_back", default: "Go back")
   ) %>
<%= render "recording_studio_admin/shared/page_nav" unless recording_studio_admin_default_layout? %>
<% if notice.present? %>
  <%= render FlatPack::Alert::Component.new(description: notice, style: :success) %>
<% end %>
<% if alert.present? %>
  <%= render FlatPack::Alert::Component.new(description: alert, style: :danger) %>
<% end %>
<% badge = local_assigns[:badge] %>
<% subtitle = local_assigns[:subtitle] %>
<% if badge %>
  <div class="flex flex-wrap items-start gap-2">
    <%= render FlatPack::PageTitle::Component.new(title: title, subtitle: subtitle) %>
    <%= render badge %>
  </div>
<% else %>
  <%= render FlatPack::PageTitle::Component.new(title: title, subtitle: subtitle) %>
<% end %>

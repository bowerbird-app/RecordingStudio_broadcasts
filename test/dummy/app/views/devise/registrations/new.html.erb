<%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do |card| %>
  <% card.body do %>
    <div class="space-y-6">
      <%= render FlatPack::PageTitle::Component.new(title: "Sign up", variant: :h2, class: "mb-0 pb-0") %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <div class="space-y-4">
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= render FlatPack::EmailInput::Component.new(
            name: "#{resource_name}[email]",
            label: "Email",
            value: resource.email,
            placeholder: "you@example.com",
            required: true
          ) %>
          <%= render FlatPack::PasswordInput::Component.new(
            name: "#{resource_name}[password]",
            label: "Password",
            help_text: @minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil,
            required: true
          ) %>
          <%= render FlatPack::PasswordInput::Component.new(
            name: "#{resource_name}[password_confirmation]",
            label: "Password confirmation",
            required: true
          ) %>
          <%= render FlatPack::Button::Component.new(text: "Sign up", style: :primary, type: "submit") %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% card.footer do %>
    <%= render "devise/shared/links" %>
  <% end %>
<% end %>

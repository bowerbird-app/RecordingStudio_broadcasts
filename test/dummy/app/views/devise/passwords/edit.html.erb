<%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do |card| %>
  <% card.body do %>
    <div class="space-y-6">
      <%= render FlatPack::PageTitle::Component.new(title: "Change your password", variant: :h2, class: "mb-0 pb-0") %>

      <% if alert.present? %>
        <%= render FlatPack::Alert::Component.new(description: alert, style: :danger) %>
      <% end %>
      <% if notice.present? %>
        <%= render FlatPack::Alert::Component.new(description: notice, style: :success) %>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <div class="space-y-4">
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>
          <%= render FlatPack::PasswordInput::Component.new(
            name: "#{resource_name}[password]",
            label: "New password",
            help_text: @minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil,
            required: true
          ) %>
          <%= render FlatPack::PasswordInput::Component.new(
            name: "#{resource_name}[password_confirmation]",
            label: "Confirm new password",
            required: true
          ) %>
          <%= render FlatPack::Button::Component.new(text: "Change my password", style: :primary, type: "submit") %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% card.footer do %>
    <%= render "devise/shared/links" %>
  <% end %>
<% end %>

<%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do |card| %>
  <% card.body do %>
    <div class="space-y-6">
      <%= render FlatPack::PageTitle::Component.new(title: "Forgot your password?", variant: :h2, class: "mb-0 pb-0") %>

      <% if alert.present? %>
        <%= render FlatPack::Alert::Component.new(description: alert, style: :danger) %>
      <% end %>
      <% if notice.present? %>
        <%= render FlatPack::Alert::Component.new(description: notice, style: :success) %>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <div class="space-y-4">
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= render FlatPack::EmailInput::Component.new(
            name: "#{resource_name}[email]",
            label: "Email",
            value: resource.email,
            placeholder: "you@example.com",
            required: true
          ) %>
          <%= render FlatPack::Button::Component.new(
            text: "Send me password reset instructions",
            style: :primary,
            type: "submit"
          ) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% card.footer do %>
    <%= render "devise/shared/links" %>
  <% end %>
<% end %>
